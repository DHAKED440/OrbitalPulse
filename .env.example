# Backend
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
MAX_UPLOAD_MB=20
MAX_IMAGE_DIMENSION=10000
MAX_IMAGE_PIXELS=40000000
MAX_WORKING_DIMENSION=2048
CHANGE_THRESHOLD=38
MIN_REGION_AREA=24
MIN_REGION_PERCENT=0.0001
REPORT_RETENTION_HOURS=24
STORAGE_DIR=backend/data
SAMPLES_DIR=data/samples
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI provider. Core image comparison works without credentials.
VISION_PROVIDER=disabled
VISION_API_KEY=
VISION_MODEL=
VISION_REQUEST_TIMEOUT_SECONDS=25
VISION_MAX_IMAGE_DIMENSION=1600
VISION_MAX_IMAGE_BYTES=5000000
VISION_MAX_PAYLOAD_BYTES=12000000
VISION_MAX_REGION_CROPS=3
