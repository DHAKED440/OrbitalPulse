# Backend
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
MAX_UPLOAD_MB=20
STORAGE_DIR=backend/data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vite proxies /api when this is empty; set a full URL to bypass the dev proxy.
VITE_API_BASE_URL=
VITE_MAX_UPLOAD_MB=20

# Optional AI provider. Core image comparison works without credentials.
VISION_PROVIDER=disabled
VISION_API_KEY=
VISION_MODEL=
